# Python (uv-managed)
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# Node / VS Code extension
node_modules/
out/
out-tests/
*.vsix

# Platform (web app) build output
platform/dist/

# Study data & generated study artifacts (never commit participant data)
.study-data/
*.sqlite3
results/
shadow.git/

# Environment & secrets
.env
.env.*
!.env.example
.phoenix/
*.sqlite3-*
*.tsbuildinfo

# OS / editor noise
.DS_Store
.idea/
.vscode/*
# Workspace-local settings inside packages/examples are machine-specific too.
**/.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json

# AI assistant state (local only)
.claude/
.codex/
.agents/
.impeccable/
.playwright-mcp/
skills-lock.json

# Coverage artifacts (pytest-cov, CI metrics gate)
.coverage
.coverage.*
htmlcov/

# Literature PDFs (docs/papers/README.md is the tracked index)
docs/papers/*.pdf

# Corpus harvest cache; the paper index is tracked separately.
.corpus-cache/

# Local design previews
.design-sync/
.ds-sync/
ds-bundle/
platform/.ds-shipped.css

# Local planning scratch
.superpowers/
docs/superpowers/
requirements/

# Worked-example per-recipe outputs (docs/examples): figures, tables, and
# per-recipe summaries regenerate with `python -m middleware simulate`;
# only the curated text artifacts (protocol, ethics package, report,
# notebook, data dictionary) are tracked.
docs/examples/pilot-2026/*/

# Documentation site build output
documentation/site/

# Playwright CLI session logs/snapshots
.playwright-cli/
