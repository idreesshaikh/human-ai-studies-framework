{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://masters-project.local/schemas/study-protocol.schema.json",
  "title": "Study Protocol",
  "description": "Machine-readable requirements specification of a study (study-as-code). Glossary terms: participant, condition, instrument, phase, gate, recipe.",
  "type": "object",
  "required": [
    "protocolVersion",
    "study",
    "researchQuestions",
    "conditions",
    "participants",
    "session",
    "instruments",
    "phases",
    "analysisPlan"
  ],
  "additionalProperties": false,
  "properties": {
    "protocolVersion": {
      "description": "Schema version of this protocol document. Consumers branch on it, never guess (FR-PROT-2, NFR-4). v1 = live-capture human study; v2 = adds the optional curated: mining section (FR-CUR); v3 = agent participants (FR-PROT-9): kite optional, agent leg + task harness are the instruments; v4 = the kite->tern rename (2026-07-21): instruments.tern replaces instruments.kite, agent-participant studies use anyOf(tern, agentCapture, taskHarness). v5 = declared tasks (`tasks[]`): what participants actually do, as addressable units rather than one prose sentence, so a session can be assigned one and the data can be attributed to it.",
      "type": "integer",
      "enum": [
        1,
        2,
        3,
        4,
        5
      ]
    },
    "study": {
      "type": "object",
      "required": [
        "id",
        "title",
        "researchers"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "researchers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "ethicsRef": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "researchQuestions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "text"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^RQ-[A-Za-z0-9]+$"
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "conditions": {
      "description": "Experimental arms a session runs under (not: group, treatment).",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "participants": {
      "type": "object",
      "required": [
        "planned",
        "design",
        "counterbalanced"
      ],
      "additionalProperties": false,
      "properties": {
        "planned": {
          "type": "integer",
          "minimum": 1
        },
        "design": {
          "enum": [
            "within-subjects",
            "between-subjects"
          ]
        },
        "counterbalanced": {
          "type": "boolean"
        },
        "agents": {
          "description": "Agent participants (FR-PROT-9): anonymized agent-configuration IDs recording tool + model. Optional; each entry is one agent config run under the task harness (FR-INST-16). Human and agent participants are mutually intelligible \u2014 'participant' is the glossary term for both.",
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "tool",
              "model"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "description": "Anonymized agent-config id, e.g. A01."
              },
              "tool": {
                "type": "string",
                "description": "Agent tool, e.g. claude-code."
              },
              "model": {
                "type": "string",
                "description": "Model identifier."
              }
            }
          }
        }
      }
    },
    "session": {
      "type": "object",
      "required": [
        "durationMinutes",
        "taskDescription"
      ],
      "additionalProperties": false,
      "properties": {
        "durationMinutes": {
          "type": "integer",
          "minimum": 1
        },
        "taskDescription": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "tasks": {
      "description": "What participants actually do, as addressable units. Optional: a protocol without them still describes its work in `session.taskDescription`, which stays the human summary. Declaring tasks is what makes a session assignable to one and the resulting data attributable to it.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "description": "Stable identifier, stamped onto every event a session for this task produces. Never reused for different work.",
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "description": "What the participant is asked to do.",
            "type": "string"
          },
          "minutes": {
            "description": "Expected working time for this task. The session's own durationMinutes remains the hard cap.",
            "type": "integer",
            "minimum": 1
          },
          "materials": {
            "description": "Where the work lives - a repository URL, a path, or an archive. Recorded so a replication starts from the same code, not a description of it.",
            "type": "string"
          },
          "conditions": {
            "description": "The conditions this task may run under. Omitted means all of them, which is the usual case: a task that only makes sense in one condition confounds task with condition, so naming a subset is a deliberate choice.",
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "instruments": {
      "description": "Data-collecting components configured by the protocol, keyed by instrument name.",
      "type": "object",
      "properties": {
        "tern": {
          "description": "Config for the TERN VS Code extension; nested keys mirror the real tern.* settings.",
          "type": "object",
          "required": [
            "session",
            "fatigue",
            "stuck",
            "output"
          ],
          "additionalProperties": false,
          "properties": {
            "session": {
              "type": "object",
              "required": [
                "durationMinutes"
              ],
              "additionalProperties": false,
              "properties": {
                "durationMinutes": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            "fatigue": {
              "type": "object",
              "required": [
                "intervalMinutes",
                "waitForPauseSeconds"
              ],
              "additionalProperties": false,
              "properties": {
                "intervalMinutes": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "waitForPauseSeconds": {
                  "type": "number",
                  "minimum": 0
                },
                "jitterPercent": {
                  "type": "number",
                  "minimum": 0
                },
                "quietTailMinutes": {
                  "type": "number",
                  "minimum": 0
                }
              }
            },
            "stuck": {
              "type": "object",
              "required": [
                "enabled",
                "thresholdSeconds"
              ],
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "thresholdSeconds": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "cooldownMinutes": {
                  "type": "number",
                  "minimum": 0
                },
                "languages": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            "output": {
              "type": "object",
              "required": [
                "httpEndpoint"
              ],
              "additionalProperties": false,
              "properties": {
                "httpEndpoint": {
                  "type": "string",
                  "minLength": 1
                },
                "directory": {
                  "type": "string"
                }
              }
            },
            "ideHealth": {
              "description": "Content-free IDE health/diagnostics stream (FR-INST-18). Optional \u2014 when absent the stream is disabled.",
              "type": "object",
              "required": [
                "enabled",
                "debounceSeconds"
              ],
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "debounceSeconds": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            "behavior": {
              "description": "The behavioral telemetry leg (FR-INST-5/8/9/10). Optional \u2014 when absent the leg is disabled. Streams record sizes, timings, and salted hashes, never content.",
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "description": "Master switch for the behavioral leg.",
                  "type": "boolean"
                },
                "captureFocus": {
                  "description": "Editor/tab and window focus switches.",
                  "type": "boolean"
                },
                "captureVisibleRanges": {
                  "description": "Scroll position when it settles, for coverage analysis.",
                  "type": "boolean"
                },
                "captureEditBursts": {
                  "description": "Aggregated edits with an origin guess (human / AI / paste / undo-redo).",
                  "type": "boolean"
                },
                "captureClipboard": {
                  "description": "Paste sizes and internal-copy timing.",
                  "type": "boolean"
                },
                "captureAiLifecycle": {
                  "description": "AI suggestion shown/accepted/rejected, with review latency.",
                  "type": "boolean"
                },
                "captureSaves": {
                  "description": "File save sizes.",
                  "type": "boolean"
                },
                "captureHeartbeat": {
                  "description": "Active/idle transitions.",
                  "type": "boolean"
                },
                "captureAttention": {
                  "description": "Region-level time-on-code from caret and hover.",
                  "type": "boolean"
                },
                "languages": {
                  "description": "Only files in these languages are captured.",
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "workspaceInternalOnly": {
                  "description": "Files outside the workspace are never captured, only noted.",
                  "type": "boolean"
                },
                "burstGapMs": {
                  "description": "Minimum gap between edit bursts.",
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "aiCorrelationMs": {
                  "description": "Window for tying an edit to an accepted AI suggestion.",
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "aiBlockCharThreshold": {
                  "description": "A block this large arriving this fast is treated as injected, not typed.",
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "aiBlockMaxDurationMs": {
                  "description": "The 'nobody types this fast' window paired with aiBlockCharThreshold.",
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "pasteCorrelationMs": {
                  "description": "Window for tying an edit to a paste.",
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "idleWindowSeconds": {
                  "description": "Seconds without activity before the session reads idle.",
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              }
            },
            "comprehensionProbe": {
              "description": "Comprehension probe cadence (FR-DASH-12, FR-INST-19). Optional \u2014 when absent probes are disabled.",
              "type": "object",
              "required": [
                "enabled",
                "cadence",
                "probeTypes"
              ],
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "cadence": {
                  "description": "How often to probe accepted chunks.",
                  "type": "string",
                  "enum": [
                    "every-chunk",
                    "sampled"
                  ]
                },
                "sampleRate": {
                  "description": "Fraction of chunks to probe (0\u20131, only meaningful when cadence is sampled).",
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "probeTypes": {
                  "description": "Which probe types may be shown.",
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "enum": [
                      "predict-output",
                      "locate-change"
                    ]
                  }
                }
              }
            }
          }
        },
        "metrics": {
          "description": "Static metrics are an external producer and are never implied by TERN settings.",
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "required": {
              "type": "boolean"
            },
            "cadence": {
              "type": "string",
              "enum": [
                "end-of-session",
                "snapshot"
              ]
            },
            "metricSet": {
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              ]
            }
          }
        },
        "agentCapture": {
          "description": "Provider adapter declaration. Private provider monkey-patching is not supported.",
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "required": {
              "type": "boolean"
            },
            "adapter": {
              "type": "string",
              "minLength": 1,
              "description": "A provider adapter name. Known adapters are claude-code, copilot, and generic-json; unknown names are retained and reported as unsupported."
            },
            "contentPolicy": {
              "type": "string",
              "enum": [
                "metadata-only",
                "redacted",
                "full"
              ]
            }
          }
        },
        "taskHarness": {
          "description": "External task acceptance test runner.",
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "required": {
              "type": "boolean"
            }
          }
        }
      },
      "additionalProperties": {
        "type": "object"
      }
    },
    "phases": {
      "description": "Study lifecycle phases with their gates: requirements-validation checkpoints listing the artifacts required to progress past each phase.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "gates"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "enum": [
              "design",
              "ethics",
              "pilot",
              "recruitment",
              "data-collection",
              "analysis",
              "write-up"
            ]
          },
          "gates": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "analysisPlan": {
      "description": "Which analysis recipes answer which research question.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "rq",
          "recipes"
        ],
        "additionalProperties": false,
        "properties": {
          "rq": {
            "type": "string",
            "pattern": "^RQ-[A-Za-z0-9]+$"
          },
          "recipes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "capture": {
      "description": "Optional capture orchestration contract. It derives the session manifest and records which external producers are required.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requiredProducers": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "tern",
              "metrics",
              "agent-capture",
              "workspace-snapshot",
              "participant-git",
              "task-harness",
              "agent-derived"
            ]
          }
        },
        "privacy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "agentContentPolicy": {
              "type": "string",
              "enum": [
                "metadata-only",
                "redacted",
                "full"
              ]
            },
            "rawCode": {
              "type": "boolean"
            }
          }
        },
        "metrics": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "cadence": {
              "type": "string",
              "enum": [
                "end-of-session",
                "snapshot"
              ]
            },
            "metricSet": {
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              ]
            }
          }
        },
        "snapshots": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "intervalMinutes": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "vcs": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        },
        "taskHarness": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "literature": {
      "description": "Papers justifying protocol elements (FR-LIT-3); consumed by the knowledge layer.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "paperRef",
          "justifies"
        ],
        "additionalProperties": false,
        "properties": {
          "paperRef": {
            "type": "string",
            "minLength": 1
          },
          "justifies": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "curated": {
      "description": "Curated-dataset sampling frame (FR-CUR). Present when the study mines an existing dataset instead of running live sessions; the mining adapter refuses to run without it (F2.2). Additive section \u2014 its presence does not change any live-path validation.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "samplingFrame"
      ],
      "properties": {
        "actorUnit": {
          "description": "What participantId denotes for mined rows.",
          "type": "string",
          "enum": [
            "developer",
            "repo",
            "agent"
          ]
        },
        "contentPolicy": {
          "description": "Reused FR-AGENT-5 vocabulary governing whether any raw text may enter mined payloads.",
          "type": "string",
          "enum": [
            "metadata-only",
            "redacted",
            "full"
          ]
        },
        "conditions": {
          "description": "The comparison arms this frame populates (the condition values on mined rows).",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "samplingFrame": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "query",
            "window"
          ],
          "properties": {
            "query": {
              "type": "string",
              "description": "The source search query."
            },
            "window": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "start",
                "end"
              ],
              "properties": {
                "start": {
                  "type": "string"
                },
                "end": {
                  "type": "string"
                }
              }
            },
            "inclusionRules": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "exclusions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "targetN": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "protocolVersion"
        ],
        "properties": {
          "protocolVersion": {
            "enum": [
              1,
              2
            ]
          }
        }
      },
      "then": {
        "properties": {
          "instruments": {
            "required": [
              "kite"
            ]
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "protocolVersion"
        ],
        "properties": {
          "protocolVersion": {
            "const": 3
          }
        }
      },
      "then": {
        "properties": {
          "instruments": {
            "anyOf": [
              {
                "required": [
                  "kite"
                ]
              },
              {
                "required": [
                  "agentCapture"
                ]
              },
              {
                "required": [
                  "taskHarness"
                ]
              }
            ]
          }
        }
      }
    },
    {
      "$comment": "kite -> tern rename (2026-07-21): v4 requires tern in place of kite, retaining the agent-participant anyOf. v5 inherits this unchanged; it adds tasks, not instruments.",
      "if": {
        "required": [
          "protocolVersion"
        ],
        "properties": {
          "protocolVersion": {
            "enum": [
              4,
              5
            ]
          }
        }
      },
      "then": {
        "properties": {
          "instruments": {
            "anyOf": [
              {
                "required": [
                  "tern"
                ]
              },
              {
                "required": [
                  "agentCapture"
                ]
              },
              {
                "required": [
                  "taskHarness"
                ]
              }
            ]
          }
        }
      }
    }
  ]
}
