        "id": "bfi2_48",
        "text": "Leaves a mess, doesn’t clean up",
        "scale": {
          "min": 1,
          "max": 5,
          "step": 1,
          "lowLabel": "Disagree strongly",
          "highLabel": "Agree strongly"
        },
        "reverse": true
      },
      {
        "id": "bfi2_49",
        "text": "Rarely feels anxious or afraid",
        "scale": {
          "min": 1,
          "max": 5,
          "step": 1,
          "lowLabel": "Disagree strongly",
          "highLabel": "Agree strongly"
        },
        "reverse": true
      },
      {
        "id": "bfi2_50",
        "text": "Thinks poetry and plays are boring",
        "scale": {
          "min": 1,
          "max": 5,
          "step": 1,
          "lowLabel": "Disagree strongly",
          "highLabel": "Agree strongly"
        },
        "reverse": true
      },
      {
        "id": "bfi2_51",
        "text": "Prefers to have others take charge",
        "scale": {
          "min": 1,
          "max": 5,
          "step": 1,
          "lowLabel": "Disagree strongly",
          "highLabel": "Agree strongly"
        },
        "reverse": true
      },
      {
        "id": "bfi2_52",
        "text": "Is polite, courteous to others",
        "scale": {
          "min": 1,
          "max": 5,
          "step": 1,
          "lowLabel": "Disagree strongly",
          "highLabel": "Agree strongly"
        },
        "reverse": false
      },
      {
        "id": "bfi2_53",
        "text": "Is persistent, works until the task is finished",
        "scale": {
          "min": 1,
          "max": 5,
          "step": 1,
          "lowLabel": "Disagree strongly",
          "highLabel": "Agree strongly"
        },
        "reverse": false
      },
      {
        "id": "bfi2_54",
        "text": "Tends to feel depressed, blue",
        "scale": {
          "min": 1,
          "max": 5,
          "step": 1,
          "lowLabel": "Disagree strongly",
          "highLabel": "Agree strongly"
        },
        "reverse": false
      },
      {
        "id": "bfi2_55",
        "text": "Has little interest in abstract ideas",
        "scale": {
          "min": 1,
          "max": 5,
          "step": 1,
          "lowLabel": "Disagree strongly",
          "highLabel": "Agree strongly"
        },
        "reverse": true
      },
      {
        "id": "bfi2_56",
        "text": "Shows a lot of enthusiasm",
        "scale": {
          "min": 1,
          "max": 5,
          "step": 1,
          "lowLabel": "Disagree strongly",
          "highLabel": "Agree strongly"
        },
        "reverse": false
      },
      {
        "id": "bfi2_57",
        "text": "Assumes the best about people",
        "scale": {
          "min": 1,
          "max": 5,
          "step": 1,
          "lowLabel": "Disagree strongly",
          "highLabel": "Agree strongly"
        },
        "reverse": false
      },
      {
        "id": "bfi2_58",
        "text": "Sometimes behaves irresponsibly",
        "scale": {
          "min": 1,
          "max": 5,
          "step": 1,
          "lowLabel": "Disagree strongly",
          "highLabel": "Agree strongly"
        },
        "reverse": true
      },
      {
        "id": "bfi2_59",
        "text": "Is temperamental, gets emotional easily",
        "scale": {
          "min": 1,
          "max": 5,
          "step": 1,
          "lowLabel": "Disagree strongly",
          "highLabel": "Agree strongly"
        },
        "reverse": false
      },
      {
        "id": "bfi2_60",
        "text": "Is original, comes up with new ideas",
        "scale": {
          "min": 1,
          "max": 5,
          "step": 1,
          "lowLabel": "Disagree strongly",
          "highLabel": "Agree strongly"
