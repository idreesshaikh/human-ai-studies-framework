        "scale": {
          "min": 1,
          "max": 5,
          "step": 1,
          "lowLabel": "Not confident",
          "highLabel": "Very confident"
        },
        "reverse": false
      },
      {
        "id": "familiarity",
        "text": "How familiar are you with the kind of task used in this study?",
        "scale": {
          "min": 1,
          "max": 5,
          "step": 1,
          "lowLabel": "Unfamiliar",
          "highLabel": "Very familiar"
        },
        "reverse": false
      }
    ],
    "scoring": "mean",
