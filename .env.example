# Copy to .env and fill in what you need. Nothing here is required to run locally:
# without a model key the design conversation is off, and templates, validation,
# assignment, capture, analysis and exports still work.

# --- Language model (design conversation and optional paper re-ranking) ---------
# Any OpenAI-compatible chat-completions endpoint works: a hosted API, or a local
# server such as Ollama or vLLM. Settings are read when a client is built, so a
# restart is enough to switch provider or model.
# LLM_API_KEY=
# LLM_BASE_URL=https://api.mistral.ai/v1            # API base or full /chat/completions URL
# LLM_MODEL=ministral-14b-latest                    # shared default for every route
# LLM_DESIGN_MODEL=                                 # overrides LLM_MODEL for design turns
# LLM_TIMEOUT_S=60                                  # per request
# LLM_STREAM_TIMEOUT_S=120
# LLM_MAX_RETRIES=2                                 # on 429/5xx/connection errors (0-5)
# LLM_ALLOW_HTTP=0                                  # 1 allows plain http to a non-local host
# A local server needs no key: LLM_BASE_URL=http://localhost:11434/v1
# Legacy names still work and are overridden by the LLM_* names above:
MISTRAL_API_KEY=
# MISTRAL_MODEL=
# MISTRAL_DESIGN_MODEL=

# --- Server ----------------------------------------------------------------------
MIDDLEWARE_PORT=8000
MIDDLEWARE_DB=.study-data/middleware.sqlite3
MIDDLEWARE_DATA_DIR=.study-data
# PostgreSQL takes precedence over MIDDLEWARE_DB.
# DATABASE_URL=postgresql://user:password@localhost:5432/phoenix
# Built web app. Relative paths resolve from the repository root.
# MIDDLEWARE_WEB=platform/dist
# 1 starts the API without a built web app (tests, API-only deployments).
# MIDDLEWARE_API_ONLY=0
# Comma-separated browser origins allowed to call the API cross-origin.
# MIDDLEWARE_CORS_ORIGINS=
# Public base URL used when building participant links behind a proxy.
# MIDDLEWARE_PUBLIC_URL=
# Optional: load a study directly from a protocol.
# MIDDLEWARE_PROTOCOL=protocol/examples/pilot-study.yaml
# Set to 0, false or no to skip the background paper-index import; any other
# set value forces it. Leave unset to use the database-dependent default.
# MIDDLEWARE_CORPUS_BOOTSTRAP=

# --- Sign-in ----------------------------------------------------------------------
# Shared-token mode: set both values to enable it.
# MIDDLEWARE_AUTH=token
# MIDDLEWARE_TOKEN=
# Hosted sign-in (Clerk): set all three.
# MIDDLEWARE_CLERK_JWKS_URL=
# MIDDLEWARE_CLERK_ISSUER=
# MIDDLEWARE_CLERK_PUBLISHABLE_KEY=

# --- Literature --------------------------------------------------------------------
# Semantic Scholar key (higher rate limit). S2_API_KEY is accepted as an alias.
# MIDDLEWARE_S2_API_KEY=
# S2_API_KEY=

# Fetch new papers on a schedule (hours between runs). Unset = never; use the CLI instead.
# MIDDLEWARE_REFRESH_INTERVAL_H=24
# Queries for the refresh (default: docs/papers/refresh-queries.json).
# MIDDLEWARE_REFRESH_QUERIES=
# Put your address in the User-Agent so arXiv can reach you if a job misbehaves.
# MIDDLEWARE_CONTACT_EMAIL=

# --- Web app build (read by Vite, not the server) -----------------------------------
# VITE_API_BASE=
