# Local single-researcher server.
MIDDLEWARE_HOST=127.0.0.1

# Optional model-assisted study design. A key by itself selects Mistral.
LLM_API_KEY=

# Example for Ollama. Leave the key blank and set both values.
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_MODEL=qwen2.5:7b
# LLM_DESIGN_MODEL=another-model-id

# Design-chat turns search Semantic Scholar when the local library has little
# on a topic, sending keywords from the conversation. Set to 0 to turn it off.
# MIDDLEWARE_LIVE_SEARCH=1

# AI-use calibration kit (scripts/calibration_session.py and
# scripts/calibration_drive.cjs). The server ignores these.
# Session folder; defaults to ~/ai-use-calibration. Use an absolute path.
# CALIBRATION_HOME=/absolute/path/to/ai-use-calibration
# Default post-session reviewer for `verify`: none, codex or claude.
# CALIBRATION_REVIEWER=none
# Reviewer executables, if not on PATH.
# CALIBRATION_CODEX=codex
# CALIBRATION_CLAUDE=claude
# Debugging port the rehearsal driver opens VS Code with.
# CALIBRATION_CDP_PORT=9333
